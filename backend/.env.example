# Copie este arquivo para .env e preencha com os dados do PostgreSQL.
# As variáveis só são usadas no perfil "prod":
#   ./mvnw spring-boot:run "-Dspring-boot.run.profiles=prod"
# Sem o perfil prod, a aplicação usa H2 em memória e ignora este arquivo.
DB_URL=jdbc:postgresql://<host>/<database>?sslmode=require
DB_USERNAME=<usuario>
DB_PASSWORD=<senha>

# Segredo para assinar os tokens JWT (mínimo de 32 caracteres)
JWT_SECRET=<segredo>

# Origens do frontend autorizadas (separadas por vírgula). Padrão: http://localhost:5173
# CORS_ALLOWED_ORIGINS=https://meu-front.vercel.app
